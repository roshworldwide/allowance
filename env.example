# ALLOWANCE environment. Copy to .env.local (git-ignored) and fill in the blanks yourself.
# Never commit real values. `npm run doctor` checks these by NAME only and never prints a value.

# Sandbox only: the app refuses to start unless PAYPAL_ENV=sandbox (API base is fixed to
# https://api-m.sandbox.paypal.com in code). There is no live mode.
PAYPAL_ENV=sandbox

# PayPal sandbox REST app "ALLOWANCE" (developer.paypal.com -> Apps & Credentials -> Sandbox).
# Needs: Accept payments, Vault (Advanced options) and Transaction search.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Filled after the webhook is registered on the deployed URL. Leave empty locally.
PAYPAL_WEBHOOK_ID=

# AG Studio licence key (/control-room). It is sent to the browser by design (it unlocks the
# dashboard), but it still never goes into git.
AG_STUDIO=

# OpenAI key. Local: project "allowance-dev". Render: project "allowance-demo".
AG_STUDIO_OPENAI_API_KEY=
# Comma-separated model ids this key may use; the first is the default (set after spike S0).
OPENAI_MODELS=
# Optional, demo video only: ElevenLabs key for cloning your own voice (npm run video:clone). Never needed by the app.
ELEVENLABS_API_KEY=
# Model for the shopping agent and task parsing. Empty = first of OPENAI_MODELS.
AGENT_MODEL=

# Passcode for "Run it live" and the Studio chat on the public demo.
DEMO_PASSCODE=
# Optional: key for signing the session cookie. Empty = derived from DEMO_PASSCODE.
SESSION_SECRET=

# Deployed demo only: the sandbox vault payment token + customer id re-seeded on boot
# (written to data/vault-token.json by `npm run spike:vault`; copy them into Render yourself).
DEMO_VAULT_TOKEN_ID=
DEMO_VAULT_CUSTOMER_ID=

# true only on the owner's machine: real vault revoke at PayPal and other owner-only actions.
OWNER_MODE=false

# Owner machine only: record live runs (and their approvals/undo) to replays/ for judge mode.
RECORD_REPLAYS=false

# Cost guards (US dollars).
LAB_MAX_USD=8
DAILY_OPENAI_USD_CAP=2
# Optional: per-1M-token prices for those estimates. Leave unset to use the built-in price per model.
# OPENAI_PRICE_INPUT_PER_M=
# OPENAI_PRICE_CACHED_PER_M=
# OPENAI_PRICE_OUTPUT_PER_M=

# Public links shown on the landing page (set after G4 / G2). Read at runtime.
DEMO_VIDEO_URL=
REPO_URL=

# Absolute base URL PayPal redirects back to (no trailing slash). Render: https://<service>.onrender.com
PUBLIC_BASE_URL=http://localhost:3000
