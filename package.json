{
  "name": "allowance",
  "version": "0.1.0",
  "private": true,
  "description": "A spending firewall for AI agents on PayPal (sandbox). Give your AI agent an allowance, not your wallet.",
  "license": "MIT",
  "author": "Roshan Raj",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:property": "vitest run tests/property",
    "test:contract": "vitest run tests/contract",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "doctor": "tsx --conditions=react-server scripts/doctor.ts",
    "verify-chain": "tsx --conditions=react-server scripts/verify-chain.ts",
    "lab": "tsx --conditions=react-server scripts/lab-run.ts",
    "lab:quick": "tsx --conditions=react-server scripts/lab-run.ts --quick",
    "demo:reset": "tsx --conditions=react-server scripts/demo-reset.ts",
    "smoke:sandbox": "tsx --conditions=react-server scripts/smoke-sandbox.ts",
    "record-replay": "tsx --conditions=react-server scripts/record-replay.ts",
    "spike:models": "tsx --conditions=react-server scripts/spike-models.ts",
    "spike:vault": "tsx --conditions=react-server scripts/spike-vault.ts",
    "secrets:scan": "secretlint --maskSecrets \"**/*\"",
    "prepare": "husky",
    "secrets:history": "gitleaks git --redact --no-banner . && node scripts/check-known-secrets.mjs --history",
    "secrets:build": "node scripts/check-known-secrets.mjs --build",
    "bench:guard": "tsx --conditions=react-server scripts/bench-guard.ts",
    "lab:validate": "tsx --conditions=react-server scripts/validate-scenarios.ts",
    "lab:sanity": "tsx --conditions=react-server scripts/lab-sanity.ts",
    "lab:holdout": "tsx --conditions=react-server scripts/lab-run.ts --holdout",
    "webhook:register": "tsx --conditions=react-server scripts/register-webhook.ts",
    "docs:sync": "tsx scripts/sync-docs.ts",
    "docs:check": "tsx scripts/sync-docs.ts --check",
    "go": "tsx scripts/go.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@paypal/agent-toolkit": "^1.11.0",
    "ag-grid-community": "36.3.0",
    "ag-studio": "3.1.0",
    "ag-studio-react": "3.1.0",
    "better-sqlite3": "^13.0.3",
    "geist": "^1.9.2",
    "motion": "^14.12.0",
    "next": "16.3.6",
    "openai": "^7.55.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "secretlint": "^13.1.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
